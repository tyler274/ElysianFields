{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elysianfields.invalid/contracts/m3-suite/m3-boundaries-and-states.schema.json",
  "title": "M3 Suite Closed Domain Enums and State Contracts",
  "description": "Implementation-neutral closed enums and schemas for clinical record buckets, 42 CFR Part 2 confidentiality, Connected Care lifecycle, independent privacy receipts, and Dei shard cache states.",
  "$defs": {
    "ClinicalRecordBucket": {
      "type": "string",
      "enum": [
        "Patient",
        "Problems",
        "Medications",
        "Allergies",
        "Results",
        "Vitals",
        "Notes",
        "Documents",
        "Visits",
        "Procedures",
        "Immunizations",
        "Orders",
        "History",
        "Forms",
        "Messages",
        "Other"
      ]
    },
    "ConfidentialityTag": {
      "type": "string",
      "enum": ["Standard", "Part2Sud", "Part2SudCounselingNotes"]
    },
    "ConnectedCareState": {
      "type": "string",
      "enum": ["NotInvited", "Invited", "InvitedLocked", "Connected", "Ended"]
    },
    "PrivacyReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "account_id",
        "account_incarnation",
        "operation",
        "scope_id",
        "scope_version",
        "occurred_at"
      ],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "account_incarnation": { "type": "integer", "minimum": 1 },
        "operation": {
          "type": "string",
          "enum": [
            "luna_withdraw",
            "sessions_revoke",
            "evidence_delete",
            "doctor_page_delete",
            "doctor_note_delete",
            "doctor_item_delete",
            "publication_revoke",
            "device_withdraw",
            "records_withdraw",
            "follow_up_pause",
            "follow_up_cancel",
            "proactive_withdraw",
            "account_delete"
          ]
        },
        "scope_id": { "type": "string" },
        "scope_version": { "type": "integer", "minimum": 0 },
        "occurred_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "DeiShardLoadState": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "received", "total"],
          "properties": {
            "state": { "const": "loading" },
            "received": { "type": "integer", "minimum": 0 },
            "total": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "version_sha256"],
          "properties": {
            "state": { "enum": ["fresh", "stale"] },
            "version_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "retryable"],
          "properties": {
            "state": { "const": "failed" },
            "retryable": { "const": true },
            "stale_version_sha256": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
