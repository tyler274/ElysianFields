# syntax=docker/dockerfile:1.7
# Rootless multi-stage production image for the standalone public site and Dei
# recovery finder (`ef-public-site`).

FROM rust:1.99.1-slim-bookworm AS builder

WORKDIR /src

COPY Cargo.toml Cargo.lock rust-toolchain.toml deny.toml ./
COPY crates ./crates

RUN cargo build --locked --release -p ef-public-site --bin ef-public-site

FROM debian:bookworm-slim AS runtime

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 --system elysian \
    && useradd --uid 10001 --gid 10001 --system --no-create-home --shell /usr/sbin/nologin elysian

COPY --from=builder /src/target/release/ef-public-site /usr/local/bin/ef-public-site

ENV EF_PUBLIC_BIND=0.0.0.0:8082 \
    EF_PUBLIC_MODE=production

USER 10001:10001
EXPOSE 8082

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8082/health >/dev/null \
        && curl -fsS http://127.0.0.1:8082/readyz >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/ef-public-site"]
