# Unified single-origin reverse proxy gateway for Elysian Fields.
# Routes Clinic API, Mobile API, Browser Wasm client shell, and Public Site
# behind one HTTP origin (:8080) with strict security headers and zero-buffer SSE.
{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	handle /elysianfields/mobile-api/* {
		reverse_proxy mobile:8089
	}

	handle /elysianfields/api/* {
		reverse_proxy clinic:8088 {
			flush_interval -1
		}
	}

	handle /elysianfields {
		reverse_proxy clinic:8088
	}

	handle /elysianfields/* {
		reverse_proxy clinic:8088
	}

	handle /* {
		reverse_proxy public-site:8082
	}
}
